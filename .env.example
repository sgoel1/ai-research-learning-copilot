# Copy this file to .env for local development (used by both mcp_server/
# and dashboard/ - copy it into whichever folder you're running from, or
# export these as real env vars).
# In production on Databricks Apps, LAKEBASE_URL is injected from the
# "database/lakebase-url" secret via app.yaml - do NOT put a real secret
# value in this file or commit a filled-in .env.

LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# OpenAlex requires no API key - this just opts into its faster "polite
# pool" rate limits and is not a secret.
OPENALEX_MAILTO=your-email@example.com

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_USER_EMAIL=student@example.com
